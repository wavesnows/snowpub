{
  "meta": {
    "name": "wechat-morandi",
    "displayName": "莫兰迪",
    "author": "snowpub",
    "version": "1.0.0",
    "specVersion": "1",
    "dark": false
  },
  "vars": {
    "primary": "#7d8f84",
    "text": "#4a4f4d"
  },
  "base": {
    "font-size": "16px",
    "line-height": "2",
    "color": "${text}",
    "background": "#fff",
    "padding": "16px 20px",
    "letter-spacing": "0.5px",
    "word-break": "break-word",
    "overflow-wrap": "break-word"
  },
  "elements": {
    "heading": {
      "font-weight": "700",
      "margin": "1.4em 0 0.8em",
      "line-height": "1.5"
    },
    "h1": {
      "font-size": "22px",
      "color": "#5f7166",
      "letter-spacing": "1px"
    },
    "h2": {
      "font-size": "18px",
      "color": "#fff",
      "background": "#a8b8ad",
      "padding": "6px 14px",
      "border-radius": "2px"
    },
    "h3": {
      "font-size": "17px",
      "color": "#5f7166"
    },
    "h4": {
      "font-size": "16px",
      "color": "#5f7166"
    },
    "p": {
      "margin": "1.2em 0"
    },
    "a": {
      "color": "#7d8f84",
      "text-decoration": "none",
      "border-bottom": "1px solid #a8b8ad"
    },
    "img": {
      "max-width": "100%",
      "border-radius": "12px",
      "margin": "12px 0"
    },
    "blockquote": {
      "margin": "1.2em 0",
      "padding": "12px 16px",
      "background": "#eef2ef",
      "color": "#6a7a70",
      "font-size": "14px"
    },
    "code": {
      "font-family": "Menlo, Consolas, monospace",
      "font-size": "13px",
      "background": "#e9eeeb",
      "color": "#5f7166",
      "padding": "2px 4px",
      "border-radius": "3px"
    },
    "pre": {
      "background": "#f2f4f3",
      "padding": "14px",
      "border-radius": "6px",
      "overflow-x": "auto",
      "font-size": "13px",
      "line-height": "1.6",
      "margin": "1.2em 0"
    },
    "preCode": {
      "background": "transparent",
      "padding": "0",
      "color": "inherit"
    },
    "ul": {
      "padding-left": "1.6em",
      "margin": "1.2em 0"
    },
    "ol": {
      "padding-left": "1.6em",
      "margin": "1.2em 0"
    },
    "li": {
      "margin": "6px 0"
    },
    "table": {
      "width": "100%",
      "border-collapse": "collapse",
      "font-size": "14px",
      "margin": "1.2em 0"
    },
    "th": {
      "border": "1px solid #d5ddd8",
      "padding": "8px 10px",
      "text-align": "left",
      "background": "#eef2ef",
      "font-weight": "700"
    },
    "td": {
      "border": "1px solid #d5ddd8",
      "padding": "8px 10px",
      "text-align": "left"
    },
    "hr": {
      "border": "none",
      "border-top": "1px solid #c5cfc8",
      "margin": "2.2em 0"
    },
    "strong": {},
    "em": {},
    "del": {},
    "footnoteRef": {
      "color": "#7d8f84",
      "font-size": "0.8em",
      "font-weight": "400",
      "margin": "0 2px"
    },
    "footnoteBlock": {
      "max-width": "640px",
      "margin": "16px auto 0",
      "padding": "12px 16px",
      "background": "#fff",
      "border-radius": "6px",
      "font-size": "12px",
      "color": "#8a9490"
    },
    "footnoteTitle": {
      "font-weight": "600",
      "margin-bottom": "6px",
      "color": "#6a7a70"
    },
    "footnoteItem": {
      "margin": "3px 0",
      "word-break": "break-all"
    },
    "footnoteLink": {
      "color": "#7d8f84",
      "text-decoration": "none"
    }
  }
}
