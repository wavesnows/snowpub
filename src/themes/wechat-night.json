{
  "meta": {
    "name": "wechat-night",
    "displayName": "暗夜",
    "author": "snowpub",
    "version": "1.0.0",
    "specVersion": "1",
    "dark": true
  },
  "vars": {
    "primary": "#7ec699",
    "text": "#d5d5dc"
  },
  "base": {
    "font-size": "16px",
    "line-height": "1.75",
    "color": "${text}",
    "background": "#1e1e24",
    "padding": "16px 18px",
    "word-break": "break-word",
    "overflow-wrap": "break-word"
  },
  "elements": {
    "heading": {
      "font-weight": "700",
      "margin": "1.2em 0 0.6em",
      "line-height": "1.4",
      "color": "#e8e8ee"
    },
    "h1": {
      "font-size": "22px",
      "border-bottom": "1px solid #3a3a44",
      "padding-bottom": "6px"
    },
    "h2": {
      "font-size": "20px",
      "border-bottom": "1px solid #3a3a44",
      "padding-bottom": "4px"
    },
    "h3": {
      "font-size": "18px"
    },
    "h4": {
      "font-size": "16px"
    },
    "p": {
      "margin": "0.8em 0"
    },
    "a": {
      "color": "#6ab0f3",
      "text-decoration": "none",
      "border-bottom": "1px solid #6ab0f3"
    },
    "img": {
      "max-width": "100%",
      "border-radius": "4px",
      "margin": "8px 0"
    },
    "blockquote": {
      "margin": "1em 0",
      "padding": "8px 12px",
      "border-left": "3px solid #6a6a78",
      "background": "#2a2a32",
      "color": "#a8a8b5",
      "font-size": "14px"
    },
    "code": {
      "font-family": "Menlo, Consolas, monospace",
      "font-size": "13px",
      "background": "#111114",
      "color": "${primary}",
      "padding": "2px 4px",
      "border-radius": "3px"
    },
    "pre": {
      "background": "#111114",
      "border": "1px solid #33333c",
      "padding": "12px",
      "border-radius": "4px",
      "overflow-x": "auto",
      "font-size": "13px",
      "line-height": "1.5",
      "margin": "1em 0"
    },
    "preCode": {
      "background": "transparent",
      "padding": "0",
      "color": "inherit"
    },
    "ul": {
      "padding-left": "1.6em",
      "margin": "0.8em 0"
    },
    "ol": {
      "padding-left": "1.6em",
      "margin": "0.8em 0"
    },
    "li": {
      "margin": "4px 0"
    },
    "table": {
      "width": "100%",
      "border-collapse": "collapse",
      "font-size": "14px",
      "margin": "1em 0"
    },
    "th": {
      "border": "1px solid #3a3a44",
      "padding": "6px 10px",
      "text-align": "left",
      "background": "#2a2a32",
      "font-weight": "700"
    },
    "td": {
      "border": "1px solid #3a3a44",
      "padding": "6px 10px",
      "text-align": "left"
    },
    "hr": {
      "border": "none",
      "border-top": "1px solid #3a3a44",
      "margin": "1.6em 0"
    },
    "strong": {},
    "em": {},
    "del": {},
    "footnoteRef": {
      "color": "#6ab0f3",
      "font-size": "0.8em",
      "font-weight": "400",
      "margin": "0 2px"
    },
    "footnoteBlock": {
      "max-width": "640px",
      "margin": "16px auto 0",
      "padding": "12px 16px",
      "background": "#2a2a32",
      "border-radius": "4px",
      "font-size": "12px",
      "color": "#888"
    },
    "footnoteTitle": {
      "font-weight": "600",
      "margin-bottom": "6px",
      "color": "#a8a8b5"
    },
    "footnoteItem": {
      "margin": "3px 0",
      "word-break": "break-all"
    },
    "footnoteLink": {
      "color": "#6ab0f3",
      "text-decoration": "none"
    }
  }
}
