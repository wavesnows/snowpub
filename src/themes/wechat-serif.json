{
  "meta": {
    "name": "wechat-serif",
    "displayName": "墨色衬线",
    "author": "snowpub",
    "version": "1.0.0",
    "specVersion": "1",
    "dark": false
  },
  "vars": {
    "primary": "#2a2a2a",
    "text": "#2a2a2a"
  },
  "base": {
    "font-size": "15px",
    "line-height": "1.6",
    "color": "${text}",
    "background": "#fff",
    "padding": "16px 18px",
    "font-family": "Songti SC, SimSun, Georgia, serif",
    "word-break": "break-word",
    "overflow-wrap": "break-word"
  },
  "elements": {
    "heading": {
      "font-weight": "700",
      "margin": "1.3em 0 0.7em",
      "line-height": "1.4"
    },
    "h1": {
      "font-size": "22px",
      "text-align": "center",
      "border-top": "1px solid ${primary}",
      "border-bottom": "1px solid ${primary}",
      "padding": "10px 0"
    },
    "h2": {
      "font-size": "19px",
      "border-top": "1px solid #999",
      "border-bottom": "1px solid #999",
      "padding": "6px 0"
    },
    "h3": {
      "font-size": "17px"
    },
    "h4": {
      "font-size": "15px"
    },
    "p": {
      "margin": "0.7em 0"
    },
    "a": {
      "color": "#576b95",
      "text-decoration": "none",
      "border-bottom": "1px solid #576b95"
    },
    "img": {
      "max-width": "100%",
      "margin": "8px 0"
    },
    "blockquote": {
      "margin": "1em 0",
      "padding": "8px 16px",
      "font-style": "italic",
      "color": "#555",
      "font-size": "14px"
    },
    "code": {
      "font-family": "Menlo, Consolas, monospace",
      "font-size": "13px",
      "background": "#f4f4f2",
      "color": "#a0522d",
      "padding": "2px 4px"
    },
    "pre": {
      "background": "#f7f7f5",
      "border-top": "1px solid #ddd",
      "border-bottom": "1px solid #ddd",
      "padding": "12px",
      "overflow-x": "auto",
      "font-size": "13px",
      "line-height": "1.5",
      "margin": "1em 0"
    },
    "preCode": {
      "background": "transparent",
      "padding": "0",
      "color": "inherit"
    },
    "ul": {
      "padding-left": "1.6em",
      "margin": "0.7em 0"
    },
    "ol": {
      "padding-left": "1.6em",
      "margin": "0.7em 0"
    },
    "li": {
      "margin": "3px 0"
    },
    "table": {
      "width": "100%",
      "border-collapse": "collapse",
      "font-size": "14px",
      "margin": "1em 0"
    },
    "th": {
      "border": "1px solid #ccc",
      "padding": "6px 10px",
      "text-align": "left",
      "background": "#f4f4f2",
      "font-weight": "700"
    },
    "td": {
      "border": "1px solid #ccc",
      "padding": "6px 10px",
      "text-align": "left"
    },
    "hr": {
      "border": "none",
      "border-top": "1px solid ${primary}",
      "margin": "1.6em 0"
    },
    "strong": {},
    "em": {},
    "del": {},
    "footnoteRef": {
      "color": "#576b95",
      "font-size": "0.8em",
      "font-weight": "400",
      "margin": "0 2px"
    },
    "footnoteBlock": {
      "max-width": "640px",
      "margin": "16px auto 0",
      "padding": "12px 16px",
      "background": "#fff",
      "font-size": "12px",
      "color": "#888"
    },
    "footnoteTitle": {
      "font-weight": "600",
      "margin-bottom": "6px",
      "color": "#606266"
    },
    "footnoteItem": {
      "margin": "3px 0",
      "word-break": "break-all"
    },
    "footnoteLink": {
      "color": "#576b95",
      "text-decoration": "none"
    }
  }
}
