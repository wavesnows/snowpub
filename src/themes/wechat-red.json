{
  "meta": {
    "name": "wechat-red",
    "displayName": "中国红",
    "author": "snowpub",
    "version": "1.0.0",
    "specVersion": "1",
    "dark": false
  },
  "vars": {
    "primary": "#c7000b",
    "text": "#333"
  },
  "base": {
    "font-size": "16px",
    "line-height": "1.8",
    "color": "${text}",
    "background": "#fff",
    "padding": "16px 18px",
    "word-break": "break-word",
    "overflow-wrap": "break-word"
  },
  "elements": {
    "heading": {
      "font-weight": "700",
      "margin": "1.2em 0 0.6em",
      "line-height": "1.4",
      "text-align": "center",
      "letter-spacing": "2px",
      "font-family": "Songti SC, SimSun, Georgia, serif"
    },
    "h1": {
      "font-size": "20px",
      "color": "#fff",
      "background": "${primary}",
      "padding": "10px 12px"
    },
    "h2": {
      "font-size": "18px",
      "color": "#fff",
      "background": "${primary}",
      "padding": "8px 12px"
    },
    "h3": {
      "font-size": "17px",
      "color": "${primary}"
    },
    "h4": {
      "font-size": "16px",
      "color": "${primary}"
    },
    "p": {
      "margin": "0.9em 0"
    },
    "a": {
      "color": "${primary}",
      "text-decoration": "none",
      "border-bottom": "1px solid ${primary}"
    },
    "img": {
      "max-width": "100%",
      "margin": "8px 0"
    },
    "blockquote": {
      "margin": "1em 0",
      "padding": "8px 12px",
      "border-left": "3px solid ${primary}",
      "background": "#fef5f5",
      "color": "#7a4a4a",
      "font-size": "14px"
    },
    "code": {
      "font-family": "Menlo, Consolas, monospace",
      "font-size": "13px",
      "background": "#fef0f0",
      "color": "${primary}",
      "padding": "2px 4px",
      "border-radius": "3px"
    },
    "pre": {
      "background": "#f6f6f6",
      "padding": "12px",
      "overflow-x": "auto",
      "font-size": "13px",
      "line-height": "1.5",
      "margin": "1em 0"
    },
    "preCode": {
      "background": "transparent",
      "padding": "0",
      "color": "inherit"
    },
    "ul": {
      "padding-left": "1.6em",
      "margin": "0.9em 0"
    },
    "ol": {
      "padding-left": "1.6em",
      "margin": "0.9em 0"
    },
    "li": {
      "margin": "4px 0"
    },
    "table": {
      "width": "100%",
      "border-collapse": "collapse",
      "font-size": "14px",
      "margin": "1em 0"
    },
    "th": {
      "border": "1px solid #e8c8c8",
      "padding": "6px 10px",
      "text-align": "left",
      "background": "#fef5f5",
      "font-weight": "700"
    },
    "td": {
      "border": "1px solid #e8c8c8",
      "padding": "6px 10px",
      "text-align": "left"
    },
    "hr": {
      "border": "none",
      "border-top": "3px double ${primary}",
      "margin": "1.8em 0"
    },
    "strong": {},
    "em": {},
    "del": {},
    "footnoteRef": {
      "color": "${primary}",
      "font-size": "0.8em",
      "font-weight": "400",
      "margin": "0 2px"
    },
    "footnoteBlock": {
      "max-width": "640px",
      "margin": "16px auto 0",
      "padding": "12px 16px",
      "background": "#fff",
      "font-size": "12px",
      "color": "#888"
    },
    "footnoteTitle": {
      "font-weight": "600",
      "margin-bottom": "6px",
      "color": "#606266"
    },
    "footnoteItem": {
      "margin": "3px 0",
      "word-break": "break-all"
    },
    "footnoteLink": {
      "color": "${primary}",
      "text-decoration": "none"
    }
  }
}
