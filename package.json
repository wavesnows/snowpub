{
  "name": "snowpub",
  "productName": "Snowpub",
  "version": "1.0.0",
  "main": "dist/electron/main/index.js",
  "description": "A local-first WeChat Official Account writing & publishing tool with Markdown editor and draft sync",
  "author": "wavesnow",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:check": "vue-tsc --noEmit && vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "theme:samples": "npx esbuild scripts/render-theme-sample.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/render-theme-sample.mjs && node node_modules/.cache/render-theme-sample.mjs",
    "docs:build": "npx esbuild docs/guide-src/build-docs.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/build-docs.mjs && node node_modules/.cache/build-docs.mjs"
  },
  "engines": {
    "node": ">=14.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/fs-extra": "^11.0.1",
    "@types/mark.js": "^8.11.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-vue": "^2.3.3",
    "electron": "^24.1.2",
    "electron-builder": "^24.2.1",
    "markdown-it-container": "^4.0.0",
    "typescript": "^4.7.4",
    "vite": "^2.9.13",
    "vite-plugin-electron": "^0.8.1",
    "vue": "^3.2.37",
    "vue-tsc": "^0.38.3"
  },
  "env": {
    "VITE_DEV_SERVER_HOST": "127.0.0.1",
    "VITE_DEV_SERVER_PORT": 3344
  },
  "keywords": [
    "wechat",
    "wechat-official-account",
    "official-account",
    "公众号",
    "markdown",
    "markdown-editor",
    "publishing",
    "electron",
    "vite",
    "vue3",
    "vue"
  ],
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@electron/remote": "^2.0.9",
    "axios": "^1.9.0",
    "codemirror": "^6.0.2",
    "electron-log": "^4.4.8",
    "electron-store": "^8.0.2",
    "electron-updater": "^6.8.3",
    "element-plus": "2.2.9",
    "encoding": "^0.1.13",
    "fs-extra": "^11.1.1",
    "github-api": "^0.10.7",
    "mark.js": "^8.11.1",
    "markdown-it": "^14.1.1",
    "node-pty": "^1.1.0",
    "nodejs-websocket": "^1.7.2",
    "pinia": "^2.0.17",
    "simple-git": "^3.17.0",
    "uuid": "^8.3.2",
    "vue-i18n": "^9.3.0-beta.17",
    "xterm": "^5.3.0",
    "xterm-addon-canvas": "^0.5.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  }
}
